# Copy to .env next to package.json (dev) or into %APPDATA%\couch\.env (installed app). Keys never leave main process.

# Brain. Local Ollama is the default; the cloud brain is chosen in the tray, never automatically.
GEMMA_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Smallest tag that plans reliably. Try gemma3:12b if scripts/eval-plan.ts scores under 17/20.
GEMMA_MODEL=gemma3:4b
# How long Ollama keeps the model in RAM after a request ("0" frees it at once; slower next request)
GEMMA_KEEP_ALIVE=5m
# Cloud brain only (Gemini API). Empty GEMINI_MODEL = newest gemma-*-it the key can see.
GEMINI_MODEL=
GEMINI_API_KEY=

# Voice (speech-to-text and text-to-speech). Without these: text box and bubbles only.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Cloud browser (verify, read, fallback)
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Web and YouTube search
SERPAPI_API_KEY=

# Memory (profile, habit counts, chosen media titles). Without it: in-memory only.
MONGODB_URI=

# Error tracing (main process). Without it: no tracing.
SENTRY_DSN=

# Public download page shown in About, e.g. https://couch.yourname.tech
COUCH_SITE_URL=
